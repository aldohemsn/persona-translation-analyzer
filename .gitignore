# .gitignore

# Node.js dependencies
# The node_modules directory contains all of your project's dependencies.
# It can be very large and is always regenerated by running `npm install`.
/node_modules

# npm lockfile
# This file is intended to describe a single point-in-time tree of dependencies.
# While some teams commit this file, for a solo project or a simple
# client-side build process, it's often better to ignore it to avoid
# potential merge conflicts and to ensure you get updates as defined
# in your package.json.
/package-lock.json

# Build output
# This is the generated CSS file from your Tailwind build process.
# It should be regenerated during your build/deployment step, not stored
# in version control.
#/styles.css

# Log files
# These are generated by npm in case of errors and contain no value
# for the repository.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and files
# These are specific to your local editor setup (e.g., VSCode, Sublime Text)
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS-generated files
.DS_Store
Thumbs.db

